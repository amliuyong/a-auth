# Agent Auth — 环境变量模板
# 复制为 .env 后填真实值;.env 已被 .gitignore 忽略,绝不提交。
# 真实凭证/密钥不放这里,走 AWS Secrets Manager / SSM / KMS(见 SECURITY.md 安全底线)。

# === AWS ===
AWS_PROFILE=default
AWS_REGION=us-east-1
# 账号号不写进 repo;需要时从 `aws sts get-caller-identity --profile default` 取
# CDK_DEFAULT_ACCOUNT=<在 .env 本地填,勿提交>
# CDK_DEFAULT_REGION=us-east-1

# === Issuer / 域名(部署时定,示例用占位符) ===
# ISSUER=https://<issuer-host>
# 自部署:客户配置域;SaaS 租户:t{N}.aws.<domain>(见 DEPLOYMENT §0)

# === 单租户 dev 栈(AgentAuthDev)===
# AGENT_AUTH_HOST 由 CDK 从本栈 API Gateway endpoint 自动派生,无需手工配置。
# WEB_BASE_URL=https://<dev-cloudfront>.cloudfront.net        # 必填:前端公开 origin;禁止裸 execute-api 域
# AGENT_AUTH_PHASE=p2                                          # 发布阶段(缺省 p2)
# AGENT_AUTH_PASSKEY_ENABLED=1                                 # 启用 WebAuthn passkey 5 端点(默认关)
# AGENT_AUTH_DCR_MODE=initial_access_token                     # 缺省 open;公网生产可切凭票注册
# AGENT_AUTH_CIMD_ENABLED=1                                    # P1+ 启用 CIMD(默认关)
# AGENT_AUTH_CIMD_ALLOWED_DOMAINS=clients.example.com           # 全局精确 host allowlist,不含 scheme/path/通配
# AGENT_AUTH_INVITATION_TTL_SECS=86400                         # Admin 一次性邀请有效期(300..604800 秒,默认 24h)
# 切换凭票档后，从租户 Admin 控制台在线签发 initial access token；不配置共享明文票据。
# 自定义域名(可选;联邦真机需稳定 redirect_uri host):
# CUSTOM_DOMAIN=auth.<domain>
# CUSTOM_DOMAIN_CERT_ARN=<us-east-1 ACM cert ARN,覆盖该域>
# CUSTOM_DOMAIN_ZONE_ID=<Route53 hosted zone id>
# CUSTOM_DOMAIN_ZONE_NAME=<hosted zone 名,如 example.com>
# AGENT_AUTH_REDIRECT_PREFIX_ALLOWED_HOSTS=["callbacks.example.com"] # SelfHosted prefix host allowlist；缺省全关

# === SaaS 多租户栈(AgentAuthSaas;仅当 SAAS_ZONE 设置时才实例化)===
# 部署 SaaS 栈须齐备下列 env(域名/zone 非敏感,可填真值到 .env;账号号/secret 绝不入 repo)。
# 租户走 t{N}.<zone> 子域(每子域独立 issuer),控制面 c.<zone> 非 issuer(discovery→400)。
# SaaS issuer 由入站子域派生,同样无需设置 AGENT_AUTH_HOST。
# SAAS_ZONE=<zone,如 example.com 的托管子域>              # 设了才实例化 SaaS 栈
# SAAS_ZONE_NAME=<同 SAAS_ZONE,Route53 hosted zone 名>
# SAAS_ZONE_ID=<Route53 hosted zone id>
# SAAS_CONTROL_HOST=c.<zone>                               # 控制面 host(非租户 issuer)
# SAAS_WEB_BASE_URL=https://c.<zone>                       # SaaS 栈必填:前端 SPA origin
# SAAS_DOMAINS=t1.<zone>,t2.<zone>,t3.<zone>,c.<zone>     # 保留已 offboard issuer 标签；新增 t3
SAAS_REPLICA_REGIONS=us-west-2                             # 生产 SaaS 必填;不得静默移除多区域 admission fence
# SAAS_CERT_ARN=<us-east-1 ACM 通配证书 ARN,覆盖 *.<zone>>  # 动态取:aws acm list-certificates ... DomainName=='*.<zone>'
# SAAS_TENANT_ADMIN_SECRET_ARNS={"t1":"arn:...:secret:tenant-t1","t2":"arn:...:secret:tenant-t2","t3":"arn:...:secret:tenant-t3"}
# SAAS_TENANT_SUBJECT_TYPES={"t3":"public"}                 # 未列租户使用 SaaS 隐私默认 pairwise
# SAAS_REDIRECT_PREFIX_ALLOWED_HOSTS={"t1":["callbacks.example.com"]} # 显式逐租户 prefix host allowlist；缺省全关
# SAAS_OFFBOARDED_TENANTS=t2                               # 仅允许该 owner 的已删除 target 在 migration 中跳过
# SAAS_PASSKEY_ENABLED=1                                    # SaaS 租户 passkey 独立开关(默认关)
# SAAS_ORIGIN_AUTH_REVISION=2026-08-08-a                    # 每次仅轮换一个 edge secret 后递增;见 SAAS_ORIGIN_AUTH.md
# AGENT_AUTH_CIMD_TENANT_ALLOWED_DOMAINS={"t1":["one.example.com"],"t2":["two.example.com"]}

# === Stable MCP Enterprise-Managed Authorization (EMA;默认关)===
# policy 建议放本机 JSON 文件；CDK 读取后只注入对应 API Lambda。格式见 docs/INSTALL_DEPLOY.md §3.3。
# AGENT_AUTH_EMA_POLICIES_FILE=/absolute/path/to/dev-ema-policies.json
# AGENT_AUTH_EMA_ENABLED=1                                  # AgentAuthDev;须 phase>=p2 + 非空 policy
# SAAS_EMA_POLICIES_FILE=/absolute/path/to/saas-ema-policies.json
# SAAS_EMA_ENABLED=1                                        # AgentAuthSaas;policy tenant 必须属于 SAAS_DOMAINS
# 小型配置也可内联 AGENT_AUTH_EMA_POLICIES='[...]' / SAAS_EMA_POLICIES='[...]'。
# 真实 standards-compatible IdP 公网验收必须 allow_legacy_missing_resource=false。

# === Cedar/AVP 授权引擎(C10.17;两栈默认关 = 字节等价)===
# 启用是有顺序的运维动作(先建 GSI+ACTIVE → 带 policySet 部署 → RecomputeFn 首跑 publish+backfill),见 DEPLOYMENT §3。
# AGENT_AUTH_AUTHZ_ENABLED=1                                # 开签发热路径 stale fail-safe 闸(默认关)
# AGENT_AUTH_POLICY_SET_FILE=<path/to/policy.cedar>        # Cedar 策略集文件(优先);authz 开时 synth 期强制非空+sanity
# AGENT_AUTH_POLICY_SET='permit(principal, action, resource);'  # 或直接内联(小策略);大文本用 _FILE

# === 敏感项一律走 Secrets Manager / SSM,不在此明文 ===
# 例:HMAC state secret / KMS key ARN 等,存 SSM 后用其 name/ARN 引用
# STATE_HMAC_SECRET_SSM_NAME=/agent-auth/dev/state-hmac-secret
# SIGNING_KEY_ARN_PARAM=/agent-auth/dev/signing-cmk-arn
