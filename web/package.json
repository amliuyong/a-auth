{
  "name": "agent-auth-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Auth 前端交互页(consent/登录/恢复)——React+TS SPA,消费生成的 OpenAPI 类型。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-oidf-browser-bundle.mjs",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi/openapi.json -o src/api/schema.d.ts",
    "lint": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test unit/*.test.ts unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "antd": "^5.21.0",
    "i18next": "^23.15.0",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "openapi-typescript": "^7.13.0",
    "terser": "^5.43.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "whatwg-fetch": "^3.6.20"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.4"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
