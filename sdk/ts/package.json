  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
